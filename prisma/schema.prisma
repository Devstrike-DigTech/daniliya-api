generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  AFFILIATE
  INFLUENCER
  VENDOR
  ADMIN
}

/// Back-office RBAC. Only meaningful for users with role = ADMIN.
enum AdminRole {
  SUPERADMIN
  FINANCE
  SUPPORT
  USER_MANAGER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  PENDING_MANUAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  QUEUED
  DISBURSED
  VOIDED
}

enum PayoutBatchStatus {
  SCHEDULED
  REVIEW
  HELD
  PAID
  FAILED
  CANCELLED
}

enum PayoutAudience {
  AFFILIATE
  INFLUENCER
  VENDOR
}

enum PayoutItemStatus {
  PENDING
  PAID
  FAILED
}

enum TransferStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  REMOVED
}

enum FulfilmentMode {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  PAY_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderChannel {
  WEB
  AFFILIATE
  INFLUENCER
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  REMOVED
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum AffiliateTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

enum BeneficiaryType {
  AFFILIATE
  INFLUENCER
  VENDOR
}

enum PayoutModel {
  COMMISSION
  FLAT
}

enum CommissionRuleScope {
  GLOBAL
  VENDOR
  PRODUCT
}

// ─── Core ────────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(uuid())
  email     String?    @unique
  phone     String?    @unique
  password  String?
  firstName String
  lastName  String
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(PENDING_VERIFICATION)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  affiliateProfile   AffiliateProfile?
  influencerProfile  InfluencerProfile?
  vendorProfile      VendorProfile?
  adminProfile       AdminProfile?
  kycSubmission      KycSubmission?
  bankAccounts       BankAccount[]
  orders             Order[]
  cart               Cart?
  auditLogsActed     AuditLog[]         @relation("AuditActor")
  commissionRecords  CommissionRecord[]
  payoutBatchesAdmin PayoutBatch[]
  payoutItems        PayoutItem[]       @relation("PayoutBeneficiary")
  wallet             Wallet?
  bookings           Booking[]
  reviews            Review[]
  ticketsOpened      SupportTicket[]    @relation("TicketOpener")
  ticketsAssigned    SupportTicket[]    @relation("TicketAssignee")
  ticketMessages     TicketMessage[]    @relation("TicketAuthor")

  @@map("users")
}

/// Back-office staff member. Created via admin invite; carries the RBAC role.
model AdminProfile {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  role       AdminRole @default(SUPPORT)
  lastActive DateTime?
  createdAt  DateTime  @default(now())

  @@map("admin_profiles")
}

/// Payout destination. Account name is resolved server-side via bank
/// name-enquiry — never trusted from the client.
model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  isDefault     Boolean  @default(false)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kycSubmissions KycSubmission[]

  @@unique([userId, bankCode, accountNumber])
  @@map("bank_accounts")
}

// ─── Profiles ────────────────────────────────────────────────────────────────

model AffiliateProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  referralCode      String?       @unique
  tier              AffiliateTier @default(BRONZE)
  kycStatus         KycStatus @default(PENDING)
  assessmentPassed  Boolean   @default(false)
  tutorialCompleted Boolean   @default(false)
  isActive          Boolean   @default(false)
  ninEncrypted      String?
  bvnEncrypted      String?
  bankDetailsJson   String?
  kycSubmittedAt    DateTime?
  kycVerifiedAt     DateTime?
  kycRejectedReason String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tutorialProgress   AffiliateTutorialProgress[]
  assessmentAttempts AssessmentAttempt[]

  @@map("affiliate_profiles")
}

model InfluencerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  influencerCode String   @unique @default(cuid())
  socialHandles  Json
  niche          String?
  followerCount  Int?
  contentLinks   String[]
  isApproved     Boolean  @default(false)
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaignAssignments CampaignInfluencerAssignment[]
  promoCodes          PromoCode[]

  @@map("influencer_profiles")
}

model VendorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  businessName    String
  productCategory String?
  bankDetailsJson String?
  /// Platform take-rate in basis points (1000 = 10%). Vendor net = subtotal × (1 − rate).
  takeRateBps     Int      @default(1000)
  isApproved      Boolean  @default(false)
  approvedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]
  reviews  Review[]

  @@map("vendor_profiles")
}

// ─── KYC ─────────────────────────────────────────────────────────────────────

/// User-level KYC. Affiliates, influencers and vendors all verify through this
/// one record (Smile ID for identity + bank name-enquiry for the payout
/// account). NIN/BVN are optional — the live portals collect a government ID
/// upload and resolve the account name instead.
model KycSubmission {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        KycStatus    @default(PENDING)
  govIdType     String?
  govIdUrl      String?
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  ninLast4      String?
  bvnLast4      String?
  smileIdRef    String?      @unique
  reason        String?
  submittedAt   DateTime     @default(now())
  verifiedAt    DateTime?
  rejectedAt    DateTime?

  @@map("kyc_submissions")
}

// ─── Hub ─────────────────────────────────────────────────────────────────────

model Vertical {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  heroImage   String?
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  services       VerticalService[]
  portfolioItems PortfolioItem[]
  quoteRequests  QuoteRequest[]
  bookings       Booking[]

  @@map("verticals")
}

model VerticalService {
  id          String   @id @default(uuid())
  verticalId  String
  vertical    Vertical @relation(fields: [verticalId], references: [id])
  name        String
  description String?
  sortOrder   Int      @default(0)

  @@map("vertical_services")
}

model PortfolioItem {
  id         String   @id @default(uuid())
  verticalId String
  vertical   Vertical @relation(fields: [verticalId], references: [id])
  imageUrl   String
  caption    String?
  sortOrder  Int      @default(0)

  @@map("portfolio_items")
}

model QuoteRequest {
  id          String    @id @default(uuid())
  verticalId  String?
  vertical    Vertical? @relation(fields: [verticalId], references: [id])
  name        String
  email       String?
  phone       String?
  description String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("quote_requests")
}

/// A service request that runs a lifecycle (unlike the raw QuoteRequest intake).
/// customerId is null for guest submissions from the public site.
model Booking {
  id            String        @id @default(uuid())
  ref           String        @unique
  customerId    String?
  customer      User?         @relation(fields: [customerId], references: [id])
  verticalId    String?
  vertical      Vertical?     @relation(fields: [verticalId], references: [id])
  status        BookingStatus @default(REQUESTED)
  name          String
  email         String
  phone         String
  city          String?
  address       String?
  description   String
  budget        Decimal?      @db.Decimal(12, 2)
  quotedAmount  Decimal?      @db.Decimal(12, 2)
  preferredDate DateTime?
  attachments   String[]
  adminNote     String?
  cancelReason  String?
  confirmedAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@map("bookings")
}

/// Product / vendor rating. A review targets a product (and optionally records
/// the vendor for store-level rollups). Verified when tied to a delivered order.
model Review {
  id           String       @id @default(uuid())
  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id])
  vendorId     String?
  vendor       VendorProfile? @relation(fields: [vendorId], references: [id])
  orderId      String?
  rating       Int
  body         String
  status       ReviewStatus @default(PUBLISHED)
  flagReason   String?
  responseBody String?
  responseAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId])
  @@index([status])
  @@map("reviews")
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Product {
  id             String         @id @default(uuid())
  vendorId       String?
  vendor         VendorProfile? @relation(fields: [vendorId], references: [id])
  title          String
  slug           String         @unique
  description    String?
  price          Decimal        @db.Decimal(12, 2)
  commissionRate Decimal        @default(0) @db.Decimal(5, 2)
  stockQuantity  Int            @default(0)
  category       String?
  status         ProductStatus  @default(DRAFT)
  rejectedReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  commissionRules CommissionRule[]
  reviews         Review[]

  @@map("products")
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  cloudinaryId String?
  sortOrder    Int     @default(0)

  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  /// Signature gift packaging — carried through to the order at checkout.
  giftWrap  Boolean @default(false)
  giftMeta  Json?

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String         @id @default(uuid())
  /// Human-facing tracking reference, e.g. DNL-1Z5X5B
  ref             String         @unique
  customerId      String
  customer        User           @relation(fields: [customerId], references: [id])
  status          OrderStatus    @default(PENDING)
  channel         OrderChannel   @default(WEB)
  fulfilmentMode  FulfilmentMode @default(DELIVERY)
  /// Money breakdown — all Decimal(12,2) naira. total = subtotal + giftAddon + deliveryFee + tax
  subtotal        Decimal        @db.Decimal(12, 2)
  giftAddon       Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paymentRef      String?        @unique
  affiliateCode   String?
  influencerCode  String?
  promoCode       String?
  deliveryAddress Json?
  contact         Json?
  notes           String?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items             OrderItem[]
  commissionRecords CommissionRecord[]
  payment           Payment?
  shipment          Shipment?

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  /// Snapshot of the product title at purchase time — catalogue edits must not
  /// rewrite historical orders.
  titleSnapshot String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  giftWrap   Boolean @default(false)
  giftMeta   Json?
  totalPrice Decimal @db.Decimal(12, 2)

  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  /// Gateway reference (Paystack/Flutterwave). Unique so webhook replays dedupe.
  providerRef String?       @unique
  authUrl     String?
  paidAt      DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payments")
}

model Shipment {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id])
  courier           String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("shipments")
}

// ─── Commission & Payouts ─────────────────────────────────────────────────────

model CommissionRecord {
  id              String           @id @default(uuid())
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id])
  beneficiaryId   String
  beneficiary     User             @relation(fields: [beneficiaryId], references: [id])
  beneficiaryType BeneficiaryType
  amount          Decimal          @db.Decimal(12, 2)
  status          CommissionStatus @default(PENDING)
  payoutBatchId   String?
  payoutBatch     PayoutBatch?     @relation(fields: [payoutBatchId], references: [id])
  payoutItemId    String?
  payoutItem      PayoutItem?      @relation(fields: [payoutItemId], references: [id])
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  disbursedAt     DateTime?

  @@unique([orderId, beneficiaryId])
  @@map("commission_records")
}

model PayoutBatch {
  id            String            @id @default(uuid())
  ref           String            @unique
  audience      PayoutAudience
  scheduledDate DateTime
  totalAmount   Decimal           @default(0) @db.Decimal(12, 2)
  status        PayoutBatchStatus @default(SCHEDULED)
  adminId       String?
  admin         User?             @relation(fields: [adminId], references: [id])
  approvedAt    DateTime?
  disbursedAt   DateTime?
  createdAt     DateTime          @default(now())

  commissionRecords CommissionRecord[]
  items             PayoutItem[]
  checks            ComplianceCheck[]

  @@map("payout_batches")
}

model PayoutItem {
  id             String           @id @default(uuid())
  batchId        String
  batch          PayoutBatch      @relation(fields: [batchId], references: [id])
  beneficiaryId  String
  beneficiary    User             @relation("PayoutBeneficiary", fields: [beneficiaryId], references: [id])
  bankAccountId  String?
  amount         Decimal          @db.Decimal(12, 2)
  status         PayoutItemStatus @default(PENDING)
  failureReason  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  commissions CommissionRecord[]
  transfer    Transfer?

  @@map("payout_items")
}

model Transfer {
  id             String         @id @default(uuid())
  payoutItemId   String         @unique
  payoutItem     PayoutItem     @relation(fields: [payoutItemId], references: [id])
  provider       String
  providerRef    String?        @unique
  status         TransferStatus @default(PENDING)
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("transfers")
}

model ComplianceCheck {
  id      String      @id @default(uuid())
  batchId String
  batch   PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  label   String
  passed  Boolean

  @@map("compliance_checks")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  /// Cached from the ledger — the ledger is the source of truth.
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries LedgerEntry[]

  @@map("wallets")
}

/// Append-only double-entry ledger. Never updated or deleted; corrections are
/// new offsetting entries. Wallet.balance is derived from these.
model LedgerEntry {
  id           String     @id @default(uuid())
  walletId     String
  wallet       Wallet     @relation(fields: [walletId], references: [id])
  type         LedgerType
  amount       Decimal    @db.Decimal(12, 2)
  source       String
  sourceId     String?
  balanceAfter Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())

  @@index([walletId])
  @@map("ledger_entries")
}

model CommissionRule {
  id             String              @id @default(uuid())
  scope          CommissionRuleScope @default(GLOBAL)
  vendorId       String?
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id])
  affiliateRate  Decimal             @db.Decimal(5, 2)
  platformRate   Decimal             @db.Decimal(5, 2)
  influencerRate Decimal             @db.Decimal(5, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime            @default(now())

  @@map("commission_rules")
}

// ─── Influencer Campaigns ─────────────────────────────────────────────────────

model Campaign {
  id             String         @id @default(uuid())
  title          String
  brief          String?
  productIds     String[]
  payoutModel    PayoutModel    @default(COMMISSION)
  commissionRate Decimal?       @db.Decimal(5, 2)
  flatAmount     Decimal?       @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime
  status         CampaignStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignments CampaignInfluencerAssignment[]

  @@map("campaigns")
}

model CampaignInfluencerAssignment {
  id           String            @id @default(uuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id])
  influencerId String
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id])
  utmLink      String?
  promoCode    String?
  accepted     Boolean           @default(false)
  clicks       Int               @default(0)
  conversions  Int               @default(0)
  assignedAt   DateTime          @default(now())

  submissions CampaignSubmission[]

  @@unique([campaignId, influencerId])
  @@map("campaign_influencer_assignments")
}

model CampaignSubmission {
  id             String                       @id @default(uuid())
  assignmentId   String
  assignment     CampaignInfluencerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  postUrl        String
  hasAdDisclosure Boolean                     @default(false)
  status         SubmissionStatus             @default(SUBMITTED)
  reviewerNote   String?
  submittedAt    DateTime                     @default(now())
  reviewedAt     DateTime?

  @@map("campaign_submissions")
}

model PromoCode {
  id           String             @id @default(uuid())
  code         String             @unique
  campaignId   String?
  influencerId String?
  influencer   InfluencerProfile? @relation(fields: [influencerId], references: [id])
  isActive     Boolean            @default(true)
  usageCount   Int                @default(0)
  createdAt    DateTime           @default(now())

  @@map("promo_codes")
}

// ─── Tutorial & Assessment ────────────────────────────────────────────────────

model TutorialStep {
  id          String   @id @default(uuid())
  title       String
  videoUrl    String?
  content     String?
  fileUrls    String[]
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  progress AffiliateTutorialProgress[]

  @@map("tutorial_steps")
}

model AffiliateTutorialProgress {
  id          String           @id @default(uuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id])
  stepId      String
  step        TutorialStep     @relation(fields: [stepId], references: [id])
  completedAt DateTime         @default(now())

  @@unique([affiliateId, stepId])
  @@map("affiliate_tutorial_progress")
}

model AssessmentQuestion {
  id            String   @id @default(uuid())
  text          String
  options       Json
  correctOption String
  explanation   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  answers AssessmentAnswer[]

  @@map("assessment_questions")
}

model AssessmentAttempt {
  id          String           @id @default(uuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id])
  score       Int
  passed      Boolean
  attemptedAt DateTime         @default(now())

  answers AssessmentAnswer[]

  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id         String             @id @default(uuid())
  attemptId  String
  attempt    AssessmentAttempt  @relation(fields: [attemptId], references: [id])
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])
  selected   String
  isCorrect  Boolean

  @@map("assessment_answers")
}

// ─── Tracking & Audit ─────────────────────────────────────────────────────────

model ClickEvent {
  id             String   @id @default(uuid())
  influencerCode String
  campaignId     String?
  productId      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  @@map("click_events")
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  externalEventId String   @unique
  eventType       String
  payload         Json
  processedAt     DateTime @default(now())

  @@map("webhook_events")
}

/// Immutable trail of money- and status-affecting writes.
/// actorId is null for automated/system actions.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

model SupportTicket {
  id           String         @id @default(uuid())
  ref          String         @unique
  openedById   String
  openedBy     User           @relation("TicketOpener", fields: [openedById], references: [id])
  subject      String
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages TicketMessage[]

  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("TicketAuthor", fields: [authorId], references: [id])
  fromAdmin Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@map("ticket_messages")
}

